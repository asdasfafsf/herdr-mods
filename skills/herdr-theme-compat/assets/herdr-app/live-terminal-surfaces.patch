     #[test]
+    fn explicit_surface_colors_reload_without_program_output() {
+        let mut vt = Vt::new(12, 4);
+        let original = theme();
+        vt.write(b"\x1b[38;2;210;212;217;48;2;41;41;41m draft \x1b[0m\r\n\x1b[48;2;41;41;42m other \x1b[0m");
+        vt.write("\r\n\x1b[38;2;41;41;41;48;2;210;212;217;7m inverse \x1b[0m\r\n\x1b[48;2;41;41;41m█X\x1b[0m".as_bytes());
+        let before = vt.frame();
+        let mut custom = original.clone();
+        custom.background_overrides = vec![([41, 41, 41], [241, 223, 189])];
+        custom.fg = Rgb(80, 60, 46);
+        vt.set_theme(custom);
+        let adjusted = vt.frame();
+        assert_eq!(adjusted.rows[0][0].bg, Some(Rgb(241, 223, 189)));
+        assert!(contrast(adjusted.rows[0][1].fg, Rgb(241, 223, 189)) >= 4.5);
+        assert_eq!(adjusted.rows[1][1].bg, before.rows[1][1].bg);
+        assert!(!Rc::ptr_eq(&before.rows[0], &adjusted.rows[0]));
+        assert_eq!(adjusted.rows[2][1].bg, before.rows[2][1].bg, "inverse video stays unchanged");
+        assert_eq!(adjusted.rows[3][0].bg, before.rows[3][0].bg, "graphics stay unchanged");
+        assert_eq!(adjusted.rows[3][1].bg, Some(Rgb(241, 223, 189)));
+        vt.select_at(Some(CellPosition { row: 0, col: 1 }), "cell").unwrap();
+        assert_eq!(vt.frame().rows[0][1].bg, Some(original.selection_bg));
+        vt.clear_selection();
+        vt.set_theme(original);
+        let restored = vt.frame();
+        assert_eq!(restored.rows[0][1].bg, before.rows[0][1].bg);
+        assert_eq!(restored.rows[0][1].fg, before.rows[0][1].fg);
+    }
