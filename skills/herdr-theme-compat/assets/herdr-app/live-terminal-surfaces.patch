+/// A live foreground process is authoritative; an old OSC status can outlive
+/// Codex and must never recolor the shell or another program that replaces it.
+fn codex_process(record: &Value) -> Option<u64> {
+    if record.get("state").and_then(Value::as_str) != Some("live") { return None; }
+    let foreground = record.get("foreground")?;
+    let argv = foreground.get("argv")?;
+    let program = program_of(&Value::Null, Some(argv));
+    if program.get("key").and_then(Value::as_str) != Some("codex") { return None; }
+    foreground.get("pid")?.as_u64().filter(|pid| *pid > 0)
+}
